# Copy to .env.local and fill in. .env.local is gitignored.
# Get this from MongoDB Atlas → Connect → Drivers. Include the DB name in the path
# (…mongodb.net/greentouch-attendance?…). Use a dedicated, least-privilege user.
MONGODB_URI="mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/greentouch-attendance?retryWrites=true&w=majority"

# Login gate.
APP_PASSWORD="choose-a-strong-password"
# Run: openssl rand -hex 32
AUTH_SECRET="a-long-random-secret-used-to-sign-the-session-cookie"
